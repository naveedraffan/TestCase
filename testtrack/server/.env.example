# Jira integration (optional - leave blank to disable auto-issue creation)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=QA
JIRA_ISSUE_TYPE=Bug
# Set to "true" to automatically create a Jira issue whenever a test result is marked "failed"
JIRA_AUTO_CREATE_ON_FAIL=false
