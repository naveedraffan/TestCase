{
  "name": "tanstack-monorepo",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "turbo run dev",
    "dev:ssr": "turbo run dev --filter=@repo/ssr",
    "dev:csr": "turbo run dev --filter=@repo/csr",
    "build": "turbo run build",
    "start:ssr": "pnpm --filter @repo/ssr start",
    "preview:csr": "pnpm --filter @repo/csr preview",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
